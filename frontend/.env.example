# --- ElevenLabs Conversational AI (student voice) ---
# Public agent (no API key in the browser): set agent id from the ElevenLabs dashboard.
VITE_ELEVENLABS_AGENT_ID=

# Connection: default is websocket (reliable behind firewalls). Only set webrtc if you need it.
# VITE_ELEVENLABS_CONNECTION_TYPE=webrtc

# Private agent: FastAPI in /backend returns signed URLs (never put xi-api-key in the frontend).
# VITE_ELEVENLABS_USE_SIGNED_URL=true
# VITE_API_BASE_URL=http://127.0.0.1:8000
# Or in dev, with Vite proxy to :8000, you can use a relative URL:
# VITE_CONVAI_SIGNING_URL=/get_conversation

# POST transcripts to backend after each session (writes JSON under backend/data/transcripts/).
# VITE_SUBMIT_TRANSCRIPTS=true

# After ConvAI ends: POST same session payload to /get_preferences (LLM user preferences; backend TBD).
# Proxied to FastAPI in dev when VITE_API_BASE_URL is unset.

# After ConvAI, call FastAPI + Ollama to infer persona from transcript (needs backend + Ollama).
# VITE_USE_LLM_PERSONA=true

# After session ends: GET /conversation/{id} on backend (canonical ElevenLabs conversation). Set false to skip.
# VITE_FETCH_CONVERSATION_ON_END=false

# After session ends: also GET /get_conversation (signed_url + agent_id). Set false to skip.
# VITE_FETCH_GET_CONVERSATION_ROUTE_AFTER_END=false

# Path for canonical fetch (default /conversation/{id}). See src/terp/api/conversationBackend.js.
# VITE_BACKEND_CONVERSATION_PATH=/conversation

# If the agent did not emit parseable JSON, fall back to demo structured data (dev only).
# VITE_USE_EXAMPLE_ADVISOR=false

# End the ConvAI session automatically when agent messages parse to complete intake JSON (default on).
# VITE_CONVAI_AUTO_END=false
