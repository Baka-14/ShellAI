# Required for GET /get_conversation (signed URL) + GET /conversation/{id}
# If you see ElevenLabs 401 needs_authorization, the key is missing or wrong here (not in the frontend).
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
# Legacy alias only — prefer ELEVENLABS_* above
# ELEVEN_LABS_API=
# ELEVEN_LABS_AGENT_ID=

# Optional: comma-separated origins for CORS (default allows common dev ports)
# CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173

# Ollama (for POST /api/persona-from-transcript) — run `ollama serve` and `ollama pull llama3.2`
# OLLAMA_HOST=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.2

# POST /get_preferences: multiline SYSTEM_PROMPT in .env is often truncated — use a file instead:
# SYSTEM_PROMPT_FILE=prompts/preferences_system.txt
# Optional: sampling for extraction (default 0.15)
# OLLAMA_PREFERENCES_TEMP=0.15

# Jupiterp: max courses returned from /getCourses (default 10)
# JUPITERP_MAX_COURSE_CODES=10
# JUPITERP_PREFIX_DISCOVERY_LIMIT=10

# PlanetTerp (enrichment on /getCourses after Jupiterp): pacing and payload size
# PLANETTERP_PAUSE=0.35
# PLANETTERP_REVIEWS_LIMIT=12
# PLANETTERP_RAW_GRADES_MAX=40

# UMD TerpAI (Nebula) — optional; `terpai_scheduling` on POST /getCourses is currently disabled (see main.py)
# TERPAI_BASE_URL=https://terpai.umd.edu
# TERPAI_BEARER=
# TERPAI_CONVERSATION_ID=
# TERPAI_PARENT_SEGMENT_ID=
# TLS to terpai.umd.edu: 1 = verify (default; use certifi). 0 = insecure (dev only; same as POST /api/terpai/ask {"insecure_ssl": true})
# TERPAI_SSL_VERIFY=1
