# Copy to .env.terpai (same folder) or backend/.env.terpai — only TerpAI keys (valid dotenv).
# Do not put multiline SYSTEM_PROMPT here.
#
# Easiest CLI: put JWT in .terpai_bearer (one line) next to terpai_ask.py, then:
#   python terpai_ask.py "Your question"
# Conversation + segment ids are read from terpai.umd.edu_v2.har automatically.

TERPAI_BEARER=
TERPAI_CONVERSATION_ID=
TERPAI_PARENT_SEGMENT_ID=
# TERPAI_BASE_URL=https://terpai.umd.edu

# If Python fails SSL verify on macOS: use 0 only for local debugging (insecure)
# TERPAI_SSL_VERIFY=0
